<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.modules.user.mapper.UserMapper">

    <select id="findAll" resultType="com.example.demo.modules.user.model.entity.User">
        SELECT id, username, password
        FROM users
    </select>

    <select id="findById"
            parameterType="long"
            resultType="com.example.demo.modules.user.model.entity.User">
        SELECT id, username, password
        FROM users
        WHERE id = #{id}
    </select>
    <select id="findByUsername"
            parameterType="string"
            resultType="com.example.demo.modules.user.model.entity.User">

        SELECT id, username, password
        FROM users
        WHERE username = #{username}

    </select>

    <insert id="insert"
            parameterType="com.example.demo.modules.user.model.entity.User"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO users (username, password)
        VALUES (#{username}, #{password})

    </insert>


</mapper>