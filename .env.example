# ==============================================================================
# AI 智能面试与知识库辅导系统 —— 环境变量配置模板
# 复制本文件为 .env 即可根据环境调整参数
# ==============================================================================

# 数据库配置
POSTGRES_DB=ai_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# JWT 鉴权密钥（生产环境请使用至少 32 字符的复杂密钥）
JWT_SECRET=my-super-secret-key-for-ai-chatbot-project-2026

# AI 供应商 API Key（可在设置中心动态持久化配置，也可以在此预填）
# 小米 MIMO / DeepSeek / 通义千问 / 智谱 GLM
AI_DEFAULT_PROVIDER=xiaomi
