# ==============================================================================
# AI 智能面试与知识库辅导系统 —— 环境变量配置模板
# 复制本文件为 .env 即可根据环境调整参数
# ==============================================================================

# 数据库配置
POSTGRES_DB=ai_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# JWT 鉴权密钥（留空时应用重启后使用进程临时密钥，需重新登录；生产环境请配置至少 32 字符随机密钥）
JWT_SECRET=
# 额外可信的 HTTPS 模型供应商主机名，多个用逗号分隔
LLM_ALLOWED_HOSTS=

# AI 供应商 API Key（可在设置中心动态持久化配置，也可以在此预填）
# 小米 MIMO / DeepSeek / 通义千问 / 智谱 GLM
AI_DEFAULT_PROVIDER=xiaomi
